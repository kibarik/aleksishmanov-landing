---
// Корень методологии (ADR 0006): лёгкая обзорная страница. Одна схема из пяти стадий, по строке на каждую стадию
// (вопрос, шаги, выход, ссылка), основания и ответвление, короткий текст корня. Глубина — на страницах стадий.
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { allNodes, root, nodeUrl, hasPage, byRole, type MethodNode } from '../../lib/method';
import { SITE } from '../../lib/site';
import { graph, article, breadcrumbs } from '../../lib/schema';

const nodes = await allNodes();
const r = await root();
const { Content } = await render(r);
const stages = byRole(nodes, 'stage');
const extra = [...byRole(nodes, 'foundation'), ...byRole(nodes, 'branch')];
const steps = (n: MethodNode) => n.data.flow.filter((f) => f.step).map((f) => f.title);
const gate = (n: MethodNode) => n.data.gate?.title.toLowerCase();
const url = `${SITE.url}/method/`;
---
<Base title={r.data.title} description={r.data.description} type="article" current="method"
  jsonld={graph(article({ title: r.data.title, description: r.data.description, url, date: r.data.date, updated: r.data.updated, section: 'Методология' }),
    breadcrumbs([{ name: 'Главная', url: '/' }, { name: 'Методология', url: '/method/' }]))}>
  <div class="m-page">
    <header class="m-hero">
      <p class="eyebrow">Методология</p>
      <h1>{r.data.title}</h1>
      <p class="m-lead">{r.data.summary}</p>
    </header>

    <ol class="m-flow" aria-label="Пять стадий от запроса до результата">
      {stages.map((s) => (
        <li>
          <a href={nodeUrl(s)}>
            <span class="m-flow__num">{s.data.stage}</span>
            <span class="m-flow__name">{s.data.short}</span>
            {gate(s) && <span class="m-flow__gate">{gate(s)}</span>}
          </a>
        </li>
      ))}
    </ol>
    <p class="m-base">
      Под всеми стадиями — {extra.filter((e) => e.data.role === 'foundation').map((e, i) => <>{i > 0 && ' и '}<a href={nodeUrl(e)}>{e.data.short?.toLowerCase()}</a></>)}.
      {extra.filter((e) => e.data.role === 'branch').map((e) => <> Если бизнес просит не доработку, а продукт, — отдельный маршрут: <a href={nodeUrl(e)}>{e.data.short?.toLowerCase()}</a>.</>)}
    </p>

    <section class="m-stages" aria-label="Стадии">
      {stages.map((s) => (
        <article class="m-stage" id={`stadiya-${s.data.stage}`}>
          <p class="m-stage__num">{String(s.data.stage).padStart(2, '0')}</p>
          <div class="m-stage__body">
            <h2><a href={nodeUrl(s)}>{s.data.short}</a></h2>
            <p class="m-stage__q">{s.data.question}</p>
            <p class="m-stage__steps">{steps(s).join(' → ')}</p>
            {gate(s) && <p class="m-stage__out">На выходе: {gate(s)}</p>}
            {hasPage(s) && <a class="m-more" href={nodeUrl(s)}>Читать стадию</a>}
          </div>
        </article>
      ))}
    </section>

    <div class="m-text prose"><Content /></div>

    <aside class="m-cta">
      <p>Хотите разобрать свой департамент по этому процессу?</p>
      <a class="btn" href={SITE.contact.href} target="_blank" rel="noopener">{SITE.contact.label}</a>
    </aside>
  </div>
</Base>
