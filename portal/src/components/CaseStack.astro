---
// Стопка кейсов на /cases/: слайды внахлёст, спереди активный с цветной подложкой, сзади выглядывают следующие.
// Листание — стрелки, клавиатура, свайп, клик по краю заднего слайда. Без библиотеки: выбор и сравнение —
// .scratch/about-cases/research/case-slide-and-stack.md; прототип трёх вариантов — ветка prototype/about-cases.
// Без JS слайды идут списком (класс is-ready ставит скрипт). Логика позиций — scripts/case-stack.js.
import type { Material } from '../lib/materials';
import { urlFor } from '../lib/materials';
import { coverImage } from '../lib/thumbs';
import { yearsLabel } from '../scripts/case-stack.js';

interface Props { cases: Material[] }
const cases = [...Astro.props.cases].sort((a, b) => ((a.data as any).order ?? 100) - ((b.data as any).order ?? 100));
const n = (i: number) => String(i + 1).padStart(2, '0');
const total = n(cases.length - 1);
---
<section class="stack" role="region" aria-roledescription="карусель" aria-label="Кейсы" data-stack>
  <div class="stack__stage">
    <div class="stack__deck" tabindex="0" aria-label="Стопка кейсов: листайте стрелками, свайпом или кнопками под ней" data-stack-deck>
      {cases.map((m, i) => {
        const c = m.data as any;
        const img = c.cover ? coverImage(c.cover) : null;
        return (
          <article class="slide" role="group" aria-roledescription="слайд" aria-label={`${i + 1} из ${cases.length}: ${c.title}`}
            style={`--tone:${c.tone}`} data-stack-slide={i}>
            <header class="slide__head">
              <span class="slide__tag">Кейс {n(i)} · {yearsLabel(c.years)} · {c.kind}</span>
              <a class="slide__open" href={urlFor(m)}>Открыть кейс<span aria-hidden="true"> →</span></a>
            </header>
            <div class="slide__body">
              <div class="slide__text">
                <p class="slide__context">{c.context}</p>
                <h2 class="slide__title"><a href={urlFor(m)}>{c.title}</a></h2>
                <dl class="slide__metrics">{c.metrics.map((x: { value: string; label: string }) => <div><dt>{x.value}</dt><dd>{x.label}</dd></div>)}</dl>
                <p class="slide__meta"><b>{c.role}</b>{c.stack.length > 0 && <> · {c.stack.join(' · ')}</>}</p>
              </div>
              {img ? (
                <figure class="slide__visual">
                  <img src={img.src} srcset={img.srcset} sizes="(max-width: 720px) 100vw, 520px" width={img.width} height={img.height} alt={c.coverAlt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </figure>
              ) : (
                <ol class="slide__steps">{c.steps.map((s: string) => <li>{s}</li>)}</ol>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
  <div class="stack__controls" hidden data-stack-controls>
    <button class="stack__btn" type="button" aria-label="Предыдущий кейс" data-stack-prev>←</button>
    <span class="stack__count"><b data-stack-count>01</b> / {total}</span>
    <button class="stack__btn" type="button" aria-label="Следующий кейс" data-stack-next>→</button>
  </div>
  <p class="visually-hidden" aria-live="polite" data-stack-status></p>
</section>

<script>
  import { wrap, stackPositions, swipeStep } from '../scripts/case-stack.js';

  for (const root of document.querySelectorAll<HTMLElement>('[data-stack]')) {
    const deck = root.querySelector<HTMLElement>('[data-stack-deck]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-stack-slide]')];
    const count = root.querySelector('[data-stack-count]')!;
    const status = root.querySelector('[data-stack-status]')!;
    let cur = 0;

    function show(i: number, announce = true) {
      cur = wrap(i, slides.length);
      stackPositions(slides.length, cur).forEach((pos, k) => {
        const s = slides[k];
        s.dataset.pos = String(pos);
        // задние слайды не inert: inert отключил бы клик по их краю (MDN) — прячем от скринридера и из Tab
        s.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
        s.querySelectorAll('a').forEach((a) => { a.tabIndex = pos === 0 ? 0 : -1; });
      });
      count.textContent = String(cur + 1).padStart(2, '0');
      if (announce) status.textContent = `Кейс ${cur + 1} из ${slides.length}: ${slides[cur].querySelector('.slide__title')!.textContent}`;
    }

    root.classList.add('is-ready');
    root.querySelector<HTMLElement>('[data-stack-controls]')!.hidden = slides.length < 2;
    show(0, false);
    root.querySelector('[data-stack-prev]')!.addEventListener('click', () => show(cur - 1));
    root.querySelector('[data-stack-next]')!.addEventListener('click', () => show(cur + 1));
    deck.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
    });

    // свайп пальцем: передний слайд идёт за пальцем, дальше порога — следующий/предыдущий
    let x0: number | null = null;
    let moved = false;
    deck.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      x0 = e.clientX; moved = false;
      try { deck.setPointerCapture(e.pointerId); } catch { /* синтетическое событие без активного указателя */ }
      slides[cur].classList.add('is-dragging');
    });
    deck.addEventListener('pointermove', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 4) moved = true;
      slides[cur].style.transform = `translateX(${dx}px) rotate(${dx / 40}deg)`;
    });
    const release = (e: PointerEvent) => {
      if (x0 === null) return;
      const dx = e.type === 'pointercancel' ? 0 : e.clientX - x0;
      x0 = null;
      slides[cur].classList.remove('is-dragging');
      slides[cur].style.transform = '';
      const step = swipeStep(dx);
      if (step) show(cur + step);
    };
    deck.addEventListener('pointerup', release);
    deck.addEventListener('pointercancel', release);

    // клик по выглядывающему краю заднего слайда — он выходит вперёд (ссылку на нём не открываем)
    slides.forEach((s, k) => s.addEventListener('click', (e) => {
      if (moved) { e.preventDefault(); moved = false; return; }
      if (s.dataset.pos === '0') return;
      e.preventDefault();
      show(k);
    }));
  }
</script>

<style>
  .stack { margin: 8px 0 56px; }
  .stack__stage { background: #efeeea; border-radius: 24px; padding: clamp(28px, 4vw, 48px) clamp(16px, 5vw, 72px); overflow: hidden; }
  .is-ready .stack__stage { padding-top: clamp(56px, 8vw, 96px); }
  .stack__deck { display: grid; gap: 32px; max-width: 1000px; margin: 0 auto; outline: none; }
  .stack__deck:focus-visible { outline: 2px solid var(--ink); outline-offset: 10px; border-radius: 4px; }

  /* слайд: белый лист в чёрной рамке; без JS — просто карточки списком */
  .slide { background: var(--card); border: 1.5px solid var(--ink); display: grid; grid-template-rows: auto 1fr; box-shadow: 14px 14px 0 var(--tone); }
  .is-ready .stack__deck { gap: 0; touch-action: pan-y; }
  .is-ready .slide { grid-area: 1 / 1; aspect-ratio: 16 / 9; box-shadow: none; transition: transform .55s cubic-bezier(.2,.8,.2,1), opacity .4s ease, box-shadow .4s ease; user-select: none; -webkit-user-select: none; }
  .is-ready .slide[data-pos='0'] { z-index: 4; box-shadow: 22px 22px 0 var(--tone); }
  .is-ready .slide[data-pos='1'] { z-index: 3; transform: translate(4%, -7%) scale(.97); cursor: pointer; }
  .is-ready .slide[data-pos='2'] { z-index: 2; transform: translate(8%, -14%) scale(.94); cursor: pointer; }
  .is-ready .slide[data-pos='3'] { z-index: 1; transform: translate(12%, -21%) scale(.91); opacity: 0; pointer-events: none; }
  .is-ready .slide:not([data-pos='0']) .slide__body { opacity: .3; }
  .is-ready .slide.is-dragging { transition: none; }

  .slide__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 20px; border-bottom: 1px solid var(--line); }
  .slide__tag { font: 700 12px/1.3 var(--font); letter-spacing: .08em; text-transform: uppercase; }
  .slide__open { flex: none; font-weight: 600; font-size: 14px; text-decoration: none; padding: 6px 14px; border: 1px solid var(--ink); border-radius: 999px; }
  .slide__open:hover { background: var(--ink); color: var(--paper); }
  .slide__body { display: grid; grid-template-columns: 1fr 1.05fr; min-height: 0; transition: opacity .4s; }
  .slide__text { padding: clamp(18px, 2.6vw, 34px); display: flex; flex-direction: column; gap: 12px; }
  .slide__context { margin: 0; font-size: 15px; line-height: 1.45; color: var(--muted); }
  .slide__title { margin: 0; font: 900 clamp(22px, 2.8vw, 36px)/1.08 var(--font-brand); letter-spacing: -.02em; }
  .slide__title a { text-decoration: none; }
  .slide__metrics { margin: auto 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-top: 14px; border-top: 1px solid var(--line); }
  .slide__metrics dt { font: 900 clamp(22px, 2.8vw, 40px)/1 var(--font-brand); letter-spacing: -.02em; color: var(--tone); overflow-wrap: anywhere; }
  .slide__metrics dd { margin: 6px 0 0; font-size: 12px; line-height: 1.3; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .slide__meta { margin: 0; font-size: 13px; color: var(--muted); }
  .slide__meta b { color: var(--ink); font-weight: 600; }
  .slide__visual { margin: 0; background: #f3f3f1; border-left: 1px solid var(--line); padding: clamp(14px, 2vw, 28px); display: grid; place-items: center; min-height: 0; }
  .slide__visual img { width: 100%; height: 100%; object-fit: cover; object-position: top; border: 1px solid var(--ink); }
  .slide__steps { margin: 0; padding: clamp(18px, 2.6vw, 34px) clamp(18px, 2.6vw, 34px) clamp(18px, 2.6vw, 34px) 2.6em; background: #f3f3f1; border-left: 1px solid var(--line); display: grid; align-content: center; gap: 14px; font-size: 16px; line-height: 1.45; counter-reset: step; list-style: none; }
  .slide__steps li { counter-increment: step; position: relative; }
  .slide__steps li::before { content: counter(step, decimal-leading-zero); position: absolute; left: -2em; font: 900 13px/1.7 var(--font-brand); color: var(--tone); }

  .stack__controls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 28px; }
  .stack__controls[hidden] { display: none; }
  .stack__btn { width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--ink); background: var(--card); color: var(--ink); font-size: 20px; cursor: pointer; }
  .stack__btn:hover { background: var(--ink); color: var(--paper); }
  .stack__count { font: 600 14px/1 var(--font); color: var(--muted); min-width: 64px; text-align: center; }
  .stack__count b { color: var(--ink); }

  @media (max-width: 720px) {
    .stack__stage { border-radius: 18px; padding-left: 14px; padding-right: 14px; }
    .is-ready .stack__stage { padding-top: 48px; padding-right: 24px; }
    .is-ready .slide { aspect-ratio: auto; }
    .is-ready .slide[data-pos='0'] { box-shadow: 10px 10px 0 var(--tone); }
    .is-ready .slide[data-pos='1'] { transform: translate(0, -5%) scale(.94); }
    .is-ready .slide[data-pos='2'] { transform: translate(0, -10%) scale(.88); }
    .slide { box-shadow: 10px 10px 0 var(--tone); }
    .slide__open { display: none; }
    .slide__body { grid-template-columns: 1fr; }
    .slide__visual { order: -1; border-left: 0; border-bottom: 1px solid var(--line); max-height: 200px; }
    .slide__steps { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-ready .slide, .slide__body { transition: none; }
  }
</style>
