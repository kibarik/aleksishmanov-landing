---
// Страница кейса (решения redesign, раунд 2, п. 9; образец — bersus regulatory-agency): белый фон, колонка 680px.
// Порядок: результат (заголовок) → цифры крупными блоками → контекст → роль → шаги → стек → история (Markdown).
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { SECTIONS, DIRECTION_INFO, SITE } from '../lib/site';
import { urlFor } from '../lib/materials';
import { graph, article, breadcrumbs } from '../lib/schema';
import { yearsLabel } from '../lib/cases.mjs';

interface Props { m: CollectionEntry<'cases'> }
const { m } = Astro.props;
const c = m.data;
const info = SECTIONS.cases;
const { Content } = await render(m);
const url = `${SITE.url}${urlFor(m)}`;
---
<Base title={c.title} description={c.description} type="article" image={c.cover} current="cases"
  jsonld={graph(article({ title: c.title, description: c.description, url, date: c.date, updated: c.updated, image: c.cover, section: info.title }),
    breadcrumbs([{ name: 'Главная', url: '/' }, { name: info.title, url: info.path }, { name: c.title, url: urlFor(m) }]))}>
  <link slot="head" rel="alternate" type="text/markdown" href={`${info.path}${m.id}.md`} />
  <article class="case-page">
    <p class="crumbs"><a href="/">Главная</a> / <a href={info.path}>{info.title}</a></p>
    <header class="case-head">
      <p class="case-meta">
        <span>{c.directions.map((d) => DIRECTION_INFO[d].short).join(' · ')}</span>
        <span>{yearsLabel(c.years)}</span>
        <span>{c.kind}</span>
      </p>
      <h1>{c.title}</h1>
    </header>

    <dl class="case-results">{c.metrics.map((x) => <div class="case-results__item"><dt class="case-results__value">{x.value}</dt><dd class="case-results__label">{x.label}</dd></div>)}</dl>

    <section class="case-block case-context"><h2>Контекст</h2><p>{c.context}</p></section>
    <section class="case-block case-role"><h2>Роль</h2><p>{c.role}</p></section>
    <section class="case-block case-steps"><h2>Шаги</h2><ol>{c.steps.map((s) => <li>{s}</li>)}</ol></section>
    {c.stack.length > 0 && <section class="case-block case-tech"><h2>Стек</h2><p>{c.stack.join(' · ')}</p></section>}

    <div class="prose"><Content /></div>

    <aside class="cta">
      <p>Нужна помощь с запуском продукта или внедрением ИИ в команде? Напишите — разберём вашу задачу.</p>
      <a class="btn btn--light" href={SITE.contact.href} target="_blank" rel="noopener">{SITE.contact.label}</a>
    </aside>
  </article>
</Base>

<style>
  .case-page { width: min(680px, 100% - 40px); margin: 0 auto; padding: 0 0 96px; background: #fff; }
  .case-head { padding: 40px 0 8px; }
  .case-head h1 { margin: 12px 0 0; font-size: clamp(32px, 5vw, 48px); line-height: 1.1; letter-spacing: -.02em; }
  .case-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 14px; color: var(--muted); }

  .case-results { margin: 40px 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; }
  .case-results__item { padding: 24px; border: 1.5px solid var(--ink); }
  .case-results__value { font: 800 clamp(44px, 7vw, 64px)/1 var(--font-brand); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .case-results__label { margin: 10px 0 0; font-size: 15px; color: var(--muted); }

  .case-block { margin: 0 0 32px; }
  .case-block h2 { margin: 0 0 8px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .case-block p, .case-block ol { margin: 0; font-size: 18px; line-height: 1.7; }
  .case-block ol { padding-left: 1.4em; }
</style>
