---
// Список текстового раздела (Блог, Разборы, Инструменты, Промты): белый фон, одна колонка, без картинок.
// У пункта: заголовок-ссылка, метки направлений, анонс, время чтения и дата. Презентации и Кейсы — свои шаблоны.
// Стили — здесь, в общий файл не выносим.
import { urlFor, formatDate, readingTime, type Material } from '../lib/materials';
import { DIRECTION_INFO } from '../lib/site';

interface Group { title: string; id?: string; items: Material[] }
interface Props { title: string; lead: string; groups: Group[] }
const { title, lead, groups } = Astro.props;
---
<div class="mlist-col">
  <header class="mlist-head">
    <h1>{title}</h1>
    <p class="mlist-head__lead">{lead}</p>
    {groups.length > 1 && (
      <ul class="mlist-jump">{groups.map((g) => <li><a class="mlist__tag" href={`#${g.id}`}>{g.title} · {g.items.length}</a></li>)}</ul>
    )}
  </header>
  <div class="mlist">
    {groups.map((g) => (
      <section id={g.id}>
        {g.title && <h2 class="mlist__group">{g.title}</h2>}
        <ul class="mlist__items">
          {g.items.map((m) => {
            const Heading = g.title ? 'h3' : 'h2';
            return (
              <li class="mlist__item">
                <Heading class="mlist__title"><a href={urlFor(m)}>{m.data.title}</a></Heading>
                <ul class="mlist__tags">{m.data.directions.map((d) => <li><a class="mlist__tag" href={DIRECTION_INFO[d].path}>{DIRECTION_INFO[d].short}</a></li>)}</ul>
                <p class="mlist__desc">{m.data.description}</p>
                <dl class="mlist__meta">
                  <div><dt>Время чтения</dt><dd>{readingTime(m.body)} мин</dd></div>
                  <div><dt>Дата</dt><dd><time datetime={m.data.date.toISOString()}>{formatDate(m.data.date)}</time></dd></div>
                </dl>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</div>

<style is:global>
  /* чистый белый фон страницы списка */
  body { background: #fff; }
  .mlist-col { max-width: 560px; margin: 0 auto; padding: 0 0 8px; }
  .mlist-head { padding: 40px 0 8px; }
  .mlist-head h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.12; margin: 0 0 20px; font-weight: 700; }
  .mlist-head__lead { font-size: 18px; line-height: 1.6; color: #27282c; margin: 0; }
  .mlist-jump { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 24px 0 0; }
  .mlist { padding-bottom: 24px; }
  .mlist__items, .mlist__tags { list-style: none; padding: 0; margin: 0; }
  .mlist__group { font-size: 26px; margin: 56px 0 0; scroll-margin-top: 80px; }
  .mlist__item { padding: 48px 0 0; }
  .mlist__title { font-size: clamp(22px, 3vw, 26px); line-height: 1.2; margin: 0 0 14px; font-weight: 700; }
  .mlist__title a { text-decoration: none; }
  .mlist__title a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .mlist__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
  .mlist__tag { display: inline-block; font-size: 14px; line-height: 22px; font-weight: 500; padding: 4px 16px; border-radius: 25px; background: #f5f5f5; color: #0b0b0b; text-decoration: none; }
  a.mlist__tag:hover { background: #ebebeb; }
  .mlist__desc { font-size: 16px; line-height: 1.5; color: #27282c; margin: 0 0 14px; }
  .mlist__meta { display: flex; gap: 32px; margin: 0; font-size: 14px; line-height: 1.4; }
  .mlist__meta dt { font-weight: 700; }
  .mlist__meta dd { margin: 0; font-weight: 600; color: #27282c; }
  .mlist-col ~ .pager { max-width: 560px; margin-inline: auto; }
</style>
