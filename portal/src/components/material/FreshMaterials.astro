---
// «Свежие материалы»: три последних материала того же раздела без текущего (CONTEXT.md). Список готовит страница.
import { urlFor, type Material } from '../../lib/materials';
interface Props { items: Material[] }
const { items } = Astro.props;
---
<section class="fresh" data-fresh aria-labelledby="fresh-h">
  <h2 id="fresh-h">Свежие материалы</h2>
  <ul>
    {items.map((x) => (
      <li>
        {x.data.category && <span class="fresh__cat">{x.data.category}</span>}
        <a href={urlFor(x)}>{x.data.title}</a>
      </li>
    ))}
  </ul>
</section>
<style>
  .fresh { background: var(--ink); color: #fff; border-radius: 28px; padding: 32px; height: 100%; }
  .fresh h2 { margin: 0 0 20px; font: 700 24px/1.2 var(--font-head); color: #fff; }
  .fresh ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .fresh__cat { display: block; font-size: 13px; line-height: 1.4; color: rgba(255, 255, 255, .7); }
  .fresh a { font: 700 17px/1.3 var(--font-head); color: #fff; text-decoration: none; }
  .fresh a:hover { text-decoration: underline; }
</style>
