---
// Карточка автора (CONTEXT.md): серая; фото или монограмма, имя, позиционирование, коротко о себе, профили, «Написать».
import { AUTHOR, SITE } from '../../lib/site';
---
<section class="acard" data-author-card aria-label="Автор">
  <div class="acard__top">
    {AUTHOR.photo
      ? <img class="acard__photo" src={AUTHOR.photo} alt={AUTHOR.name} width="72" height="72" loading="lazy" />
      : <span class="acard__photo acard__mono" data-monogram aria-hidden="true">{AUTHOR.monogram}</span>}
    <div>
      <p class="acard__name"><a href="/about/" rel="author">{AUTHOR.name}</a></p>
      <p class="acard__role">{AUTHOR.role}</p>
    </div>
  </div>
  <p class="acard__about">{AUTHOR.about}</p>
  <ul class="acard__profiles">{AUTHOR.profiles.map((p) => <li><a href={p.href} target="_blank" rel="noopener me">{p.label}</a></li>)}</ul>
  <a class="acard__write" href={SITE.contact.href} target="_blank" rel="noopener">Написать</a>
</section>
<style>
  .acard { background: #f5f5f5; border-radius: 28px; padding: 32px; display: flex; flex-direction: column; gap: 16px; height: 100%; }
  .acard__top { display: flex; gap: 16px; align-items: center; }
  .acard__photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .acard__mono { display: grid; place-items: center; background: var(--ink); color: #fff; font: 700 24px/1 var(--font-head); letter-spacing: .02em; }
  .acard__name { margin: 0; font: 700 20px/1.25 var(--font-head); }
  .acard__name a { text-decoration: none; }
  .acard__role { margin: 4px 0 0; font-size: 14px; line-height: 1.4; font-weight: 600; }
  .acard__about { margin: 0; font-size: 14px; line-height: 1.55; color: #27282c; font-weight: 500; }
  .acard__profiles { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  .acard__profiles a { color: var(--ink); }
  .acard__write { margin-top: auto; align-self: flex-start; padding: 10px 20px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 600; font-size: 15px; text-decoration: none; }
</style>
