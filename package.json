{
  "name": "wow-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:landing": "vite build",
    "build:portal": "astro build --root portal",
    "dev:portal": "astro dev --root portal",
    "import": "node tools/import-sources.mjs --sources ../sources",
    "test:unit": "node --test tests/unit",
    "test:portal": "npm run build && PORTAL=1 playwright test --project=portal",
    "preview": "vite preview",
    "test": "playwright test --project=desktop --project=mobile --project=no-webgl --project=firefox",
    "test:update-golden": "UPDATE_GOLDEN=1 playwright test --project=desktop --project=mobile",
    "capture:fallback": "node scripts/capture-fallback.mjs",
    "perf": "node scripts/perf-report.mjs",
    "test:build": "PREVIEW=1 playwright test --project=desktop --project=mobile --project=no-webgl",
    "test:webkit": "playwright test --project=webkit",
    "preview:build": "vite build && vite preview --port 4173 --strictPort",
    "test:prod": "PROD_URL=https://aleksishmanov.ru playwright test prod-assets prod-smoke --project=desktop --project=mobile"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.63.0",
    "astro": "^5.18.2",
    "vite": "^5.4.0"
  }
}
